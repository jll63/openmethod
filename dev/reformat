#!/bin/bash

# Format every C++ source in the repository. Pinned to clang-format 22: the
# house style needs BreakAfterOpenBracket*, which 18 and 19 reject outright.

cd "$(dirname $0)/.."

srcs=$(git ls-files --cached --others --exclude-standard \
    '*.hpp' '*.cpp' '*.ipp')

clang-format-22 -i --verbose $srcs
